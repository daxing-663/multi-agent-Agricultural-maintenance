# ============================================================
# 复制为 .env 后填入自己的值
# ============================================================

# ---- LLM 供应商（四选一）----
# deepseek：DeepSeek（默认）| openai：OpenAI | openai_compatible：任何兼容端点 | stub：离线占位
AGRIAGENTS_LLM_PROVIDER=deepseek
AGRIAGENTS_DEEP_THINK_LLM=deepseek-v4-pro     # 协调决策/工单规划/回滚预案
AGRIAGENTS_QUICK_THINK_LLM=deepseek-flash     # 感知/诊断/执行/初筛/安检
DEEPSEEK_API_KEY=

# 用 OpenAI 时：
# AGRIAGENTS_LLM_PROVIDER=openai
# AGRIAGENTS_DEEP_THINK_LLM=gpt-5.6-sol
# AGRIAGENTS_QUICK_THINK_LLM=gpt-5.6-luna
# OPENAI_API_KEY=

# 用本地/自建端点（vLLM / LM Studio / Ollama）时：
# AGRIAGENTS_LLM_PROVIDER=openai_compatible
# AGRIAGENTS_LLM_BACKEND_URL=http://localhost:8000/v1

# 离线验证框架（不花钱）：AGRIAGENTS_LLM_PROVIDER=stub

# ---- 运行行为 ----
AGRIAGENTS_OUTPUT_LANGUAGE=Chinese
AGRIAGENTS_DRY_RUN=true                        # 干跑：不下发真实设备
AGRIAGENTS_REQUIRE_HUMAN_APPROVAL=true         # 执行前必须人工审批
AGRIAGENTS_CHECKPOINT_ENABLED=false            # 断点续跑（人工审批需要它）

# ---- 轮次预算（防死循环）----
AGRIAGENTS_MAX_PERCEPTION_ROUNDS=1
AGRIAGENTS_MAX_DIAGNOSIS_ROUNDS=1
AGRIAGENTS_MAX_COORDINATION_ROUNDS=3
AGRIAGENTS_MAX_SAFETY_ROUNDS=2

# ---- 存储位置（留空使用 ~/.agriagents）----
AGRIAGENTS_RESULTS_DIR=
AGRIAGENTS_CACHE_DIR=
AGRIAGENTS_MEMORY_LOG_PATH=
